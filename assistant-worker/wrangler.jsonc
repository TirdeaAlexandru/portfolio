{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "alexandru-portfolio-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://tirdeaalexandru.github.io,http://localhost:8787,http://127.0.0.1:8787",
    "OPENAI_MODEL": "gpt-5.4-mini"
  },
  "ratelimits": [
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "810261018",
      "simple": { "limit": 12, "period": 60 }
    }
  ]
}
